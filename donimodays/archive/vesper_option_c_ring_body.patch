+# ---- option C: Vesper's body IS the broken ring. A tall oval band stands on edge, open at the upper right
+# where the old halo's gap was. The face floats in the opening; the fragments are the band's missing pieces.
+RING_ZC, RING_A, RING_B = 0.88, 0.46, 0.82     # oval centre height and half-width/half-height of the centreline
+RING_W, RING_D = 0.06, 0.105                   # band half-thickness (in the ring plane) and half-depth (front to back)
+RING_ARC = (110, 340)                          # the band runs from just left of the top, down the left, round to the right
+FRAG_ANGLES, FRAG_HALF = (10, 45, 80), 10      # the three missing pieces fill the gap
+VES_FACE_S = 1.45                              # the mask, eyes, lids and brows are 1.45x their robe-era size
+
+def ring_pt(t_deg, rad=0.0, depth=0.0):
+    """Point on the band: t along the oval, rad across it (+ outward), depth front(-)/back(+). Follows the spine lean."""
+    t = math.radians(t_deg)
+    n = Vector((RING_B * math.cos(t), 0, RING_A * math.sin(t))).normalized()
+    c = Vector((RING_A * math.cos(t), 0, RING_ZC + RING_B * math.sin(t))) + n * rad
+    sp_ = spine(c.z)
+    return Vector((c.x + sp_.x, sp_.y + depth, c.z))
+
+def ring_band(name, coll, part, t0, t1, w=RING_W, d=RING_D, seg=120, ring=20, base_flare=0.6, inner=None, cap=None):
+    """Swept band along the oval from t0 to t1 degrees. Cross-section is a soft rounded rectangle.
+    inner: material part for faces looking into the hole. cap: material part for the two broken ends."""
+    bm = bmesh.new(); rings = []
+    for i in range(seg + 1):
+        tt = t0 + (t1 - t0) * i / seg
+        dd = d * (1 + base_flare * max(0.0, -math.sin(math.radians(tt))) ** 6)   # the base widens front to back to stand
+        row = []
+        for j in range(ring):
+            a = 2 * math.pi * j / ring
+            ca, sa = math.cos(a), math.sin(a)
+            r_ = math.copysign(abs(ca) ** 0.6, ca) * w; z_ = math.copysign(abs(sa) ** 0.6, sa) * dd
+            row.append(bm.verts.new(ring_pt(tt, r_, z_)))
+        rings.append(row)
+    for i in range(seg):
+        for j in range(ring):
+            bm.faces.new((rings[i][j], rings[i][(j + 1) % ring], rings[i + 1][(j + 1) % ring], rings[i + 1][j]))
+    caps = [bm.faces.new(list(reversed(rings[0]))), bm.faces.new(rings[-1])]
+    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
+    ob = finish(name, bm, coll, part)
+    me = ob.data
+    if inner:
+        me.materials.append(mat_for(inner)); ii = len(me.materials) - 1
+        for pg in me.polygons:
+            c = pg.center; t_ = math.atan2((c.z - RING_ZC) / RING_B, (c.x - spine(c.z).x) / RING_A)
+            n = Vector((RING_B * math.cos(t_), 0, RING_A * math.sin(t_))).normalized()
+            if pg.normal.dot(n) < -0.5:
+                pg.material_index = ii
+    if cap:
+        me.materials.append(mat_for(cap)); ci = len(me.materials) - 1
+        for k in (0, len(me.polygons) - 1):
+            me.polygons[k].material_index = ci
+    return ob
+
+def ves_arm_default(side):
+    """Shoulder, elbow and wrist at rest. The left arm grows from the band's inner rim, the right from its broken end."""
+    if side < 0:
+        sh = ring_pt(160, -RING_W - 0.01, -0.02)
+        el = sh + Vector((0.06, -0.12, -0.3))
+    else:
+        sh = ring_pt(RING_ARC[1] - 3, -RING_W * 0.4, -0.02)
+        el = sh + Vector((-0.1, -0.17, -0.06))
+    wr = Vector((side * 0.03 + 0.02, -0.3, 0.72 if side < 0 else 0.64))
+    return sh, el, wr
